diff --git a/backends/reference/worker/tasks/backfill_topics.py b/backends/reference/worker/tasks/backfill_topics.py
new file mode 100644
--- /dev/null
+++ b/backends/reference/worker/tasks/backfill_topics.py
@@ -0,0 +1,34 @@
+"""Fill calls.topics for calls processed before the column existed."""
+
+from __future__ import annotations
+
+from app.models import Call, TranscriptSegment
+from app.services.diarization import flatten_transcript
+from app.services.ollama_client import OllamaClient
+from call_center_api.enrichment import parse_topics
+from call_center_api.verticals import get_profile
+from worker.celery_app import celery_app
+
+
+@celery_app.task(name="worker.tasks.backfill_topics")
+def backfill_topics() -> int:
+    from app.database import SessionLocal
+
+    db = SessionLocal()
+    client = OllamaClient()
+    try:
+        calls = db.query(Call).filter(Call.status == "completed", Call.topics.is_(None)).all()
+        for call in calls:
+            segments = (
+                db.query(TranscriptSegment)
+                .filter(TranscriptSegment.call_id == call.id)
+                .order_by(TranscriptSegment.pos)
+                .all()
+            )
+            transcript = flatten_transcript(segments)
+            prompt = get_profile(call.vertical).prompts.topics
+            call.topics = parse_topics(client.chat(prompt, transcript, json_mode=True)) if transcript.strip() else []
+            db.commit()
+        return len(calls)
+    finally:
+        db.close()
