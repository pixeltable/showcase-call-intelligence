# Copy to .env. scripts/run_compare.sh exports it to both backends and to the pxt daemon.

# Required for pyannote diarization (accept pyannote/speaker-diarization-3.1 terms on Hugging Face)
HF_TOKEN=hf-your-token-here

# Models, identical for both backends
WHISPERX_MODEL=base
WHISPERX_DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
EMBED_MODEL=all-mpnet-base-v2
MAX_UPLOAD_MB=100

# Pixeltable returns timestamps in this zone; UTC matches the Reference's Postgres.
PIXELTABLE_TIME_ZONE=UTC

# Reference only
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/callcenter
REDIS_URL=redis://localhost:6379/0
OLLAMA_TIMEOUT_SEC=300
CELERY_TASK_SOFT_TIME_LIMIT_SEC=3300
CELERY_TASK_TIME_LIMIT_SEC=3600
ENABLE_ADMIN_ENDPOINTS=false

# Ports (defaults shown). PXT_PORT is the pxt daemon's; pxt replaces a daemon of another project on it.
# REF_API_PORT=8001
# PXT_API_PORT=8000
# REF_UI_PORT=5173
# PXT_UI_PORT=5174
# PXT_PORT=22090
