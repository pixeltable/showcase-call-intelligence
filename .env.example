# Shared — copy to .env, backends/pixeltable/.env, and backends/reference/.env
# Relative PIXELTABLE_HOME is resolved from the repo root (not cwd).
# ./scripts/run_compare.sh exports repo-local data paths automatically.
PIXELTABLE_HOME=./data/pixeltable
HF_TOKEN=hf-your-token-here
WHISPERX_MODEL=base
WHISPERX_DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_SEC=300
EMBED_MODEL=all-mpnet-base-v2
OLLAMA_HOST=http://localhost:11434
CELERY_TASK_SOFT_TIME_LIMIT_SEC=3300
CELERY_TASK_TIME_LIMIT_SEC=3600
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Pixeltable (backends/pixeltable/)
MAX_QUERY_LENGTH=10000
MAX_UPLOAD_MB=100
# RESET_SCHEMA=true

# Reference (backends/reference/)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/callcenter
REDIS_URL=redis://localhost:6379/0
UPLOAD_DIR=./data/reference/uploads
ENABLE_ADMIN_ENDPOINTS=false
