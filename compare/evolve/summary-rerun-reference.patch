--- /dev/null
+++ b/backends/reference/worker/tasks/resummarize.py
@@ -0,0 +1,35 @@
+"""Re-run only the summary of every completed call, after a prompt change."""
+
+from __future__ import annotations
+
+from app.models import Call, TranscriptSegment
+from app.services.diarization import flatten_transcript
+from app.services.ollama_client import OllamaClient
+from call_center_api.enrichment import format_summary, parse_summary
+from call_center_api.verticals import get_profile
+from worker.celery_app import celery_app
+
+
+@celery_app.task(name="worker.tasks.resummarize")
+def resummarize() -> int:
+    from app.database import SessionLocal
+
+    db = SessionLocal()
+    client = OllamaClient()
+    try:
+        calls = db.query(Call).filter(Call.status == "completed").all()
+        for call in calls:
+            segments = (
+                db.query(TranscriptSegment)
+                .filter(TranscriptSegment.call_id == call.id)
+                .order_by(TranscriptSegment.pos)
+                .all()
+            )
+            transcript = flatten_transcript(segments)
+            if transcript.strip():
+                raw = client.chat(get_profile(call.vertical).prompts.summary, transcript, json_mode=True)
+                call.summary = format_summary(parse_summary(raw))
+                db.commit()
+        return len(calls)
+    finally:
+        db.close()
